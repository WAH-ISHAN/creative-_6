# CreativeFX Server Environment Variables
# Copy this file to .env and fill in strong, unique values.
# NEVER commit your real .env — it is gitignored.

# ─── REQUIRED IN PRODUCTION ───────────────────────────────────────────────
# The server refuses to start in production if these are missing or set to a
# known insecure default.

# Admin panel password. Use a strong, unique value (the old shared default has
# been retired and is rejected in production).
ADMIN_PASSWORD=

# Secret used to sign admin session tokens. Generate a strong random value with:
#   openssl rand -hex 32
SECRET_KEY=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────

# Port for the API server (default: 4000)
PORT=4000

# Comma-separated list of browser origins allowed to call the API (CORS).
# Leave blank to use the built-in defaults (localhost + creativefx.lk).
# Example: https://creativefx.lk,https://www.creativefx.lk
ALLOWED_ORIGINS=

# API URL for the React frontend. Leave blank to use the same origin (the host's
# rewrites proxy /api to the server). This is a public URL, not a secret.
# Dev example: http://localhost:4000
VITE_API_URL=
