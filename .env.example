# CreativeFX Server Environment Variables
# Copy this to .env and fill in your values

# Admin panel password (change this!)
ADMIN_PASSWORD=creativefx2026

# Secret key for token generation (change this to something random!)
SECRET_KEY=change-this-to-something-random-and-long

# Port to run the server on (default: 4000)
PORT=4000

# API URL for the React frontend to connect to
# In development: http://localhost:4000
# In production (VPS): http://your-domain.com:4000  or  https://your-domain.com/api
VITE_API_URL=http://localhost:4000
